# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
API_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DB_PATH=/data/flightdeck.sqlite
CHECK_INTERVAL_SECONDS=1800
# Optional sideload-friendly notifications: subscribe to this topic in the ntfy iOS app.
# Topic names on a public unauthenticated server are not private. Use a random name
# and preferably an access-controlled topic with an NTFY_TOKEN.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=
# Optional native APNs. Mount the key read-only into the container separately.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.gregority9.flightdeck
APNS_PRODUCTION=false
